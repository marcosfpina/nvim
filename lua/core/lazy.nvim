-- ~/.config/nvim/lua/core/lazy.lua

-- Lazy.nvim plugin manager setup

-- Bootstrap lazy.nvim if not installed

local lazypath = vim.fn.stdpath("data") .. "/lazy/lazy.nvim"

if not vim.loop.fs_stat(lazypath) then

vim.notify("Installing lazy.nvim...", vim.log.levels.INFO, { title = "Lazy.nvim" })

vim.fn.system({

"git",

"clone",

"--filter=blob:none",

"https://github.com/folke/lazy.nvim.git",

"--branch=stable",

lazypath,

})

end

vim.opt.rtp:prepend(lazypath)

-- Load the plugin manager

require("lazy").setup({

-- Import plugin specifications from separate files

{ import = "plugins.ui" }, -- UI enhancements

{ import = "plugins.editing" }, -- Editing and text manipulation

{ import = "plugins.git" }, -- Git integration

{ import = "plugins.nav" }, -- Navigation and file management

{ import = "plugins.lsp" }, -- Language Server Protocol

{ import = "plugins.coding" }, -- Coding assistance (completion, snippets, etc.)

{ import = "plugins.debug" }, -- Debugging

{ import = "plugins.lang" }, -- Language-specific plugins

{ import = "plugins.tools" }, -- Additional tools and utilities

{ import = "plugins.ai" }, -- AI-powered assistance

}, {

defaults = {

lazy = true, -- By default, load plugins on use

},

install = {

colorscheme = { "tokyonight", "habamax" },

},

checker = {

enabled = true, -- Check for plugin updates

frequency = 86400, -- Check once a day

notify = false, -- Don't notify about updates

},

change_detection = {

enabled = true,

notify = false,

},

performance = {

cache = {

enabled = true,

},

reset_packpath = true,

rtp = {

reset = true,

disabled_plugins = {

"gzip",

"matchit",

"matchparen",

"netrwPlugin",

"tarPlugin",

"tohtml",

"tutor",

"zipPlugin",

},

},

},

ui = {

border = "rounded",

size = {

width = 0.8,

height = 0.8,

},

icons = {

cmd = " ",

config = " ",

event = " ",

ft = " ",

init = " ",

keys = " ",

plugin = " ",

runtime = " ",

source = " ",

start = " ",

task = " ",

lazy = "󰒲 ",

},

},

debug = false,

})
